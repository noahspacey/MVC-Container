@model List<prjICETASK4.Models.Products>

@{
    ViewData["Title"] = "Products";
}
<div class="text-center">
    <h1>Add a Product</h1>
    <h3>Enter your deatils to continue</h3>
</div>


@using (Html.BeginForm("UploadProduct", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="form-group">
        <label for="ProductName">Product Name:</label>
        <input type="text" name="ProductName" class="form-control" placeholder="Name" required />
    </div>

    <div class="form-group">
        <label for="ProductPrice">Product Price:</label>
        <input type="number" name="ProductPrice" class="form-control" placeholder="Product Price" required />
    </div>

    <br />

    <div class="form-group">
        <button type="submit" class="btn btn-primary" value="Upload">Submit Product</button>
    </div>
}

<div class="text-center">
    <h1>Uploaded Products</h1>
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-hover">
        <caption>List of Products</caption>
        <thead>
            <tr>
                <th scope="col">Product ID</th>
                <th scope="col">Product Name</th>
                <th scope="col">Product Price</th>
            </tr>
        </thead>

        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductID</td>
                <td>@product.ProductName</td>
                <td>@product.ProductPrice</td>
            </tr>
        }
    </table>
}
else
{
    <p>No products available to display.</p>
}